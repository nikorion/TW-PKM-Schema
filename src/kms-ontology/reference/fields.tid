title: $:/plugins/nikorion/kms-ontology/reference/fields
type: text/vnd.tiddlywiki

\whitespace trim

<!-- One row per field, in canonical order. Transcluded by the reference tab and the readme. -->

<table class="kms-reference">
<thead>
<tr>
<th><<kms-ontology-lingo Reference/Column/Field>></th>
<th><<kms-ontology-lingo Reference/Column/Slug>></th>
<th><<kms-ontology-lingo Reference/Column/Kind>></th>
<th><<kms-ontology-lingo Reference/Column/Default>></th>
<th><<kms-ontology-lingo Reference/Column/Applies>></th>
<th><<kms-ontology-lingo Reference/Column/Meaning>></th>
</tr>
</thead>
<tbody>
<$list filter="[function[kms-fields]]" variable="field">
<$let kind={{{ [function[kms-field-kind],<field>] }}}
	blank={{{ [function[kms-vocab-blank],<field>] }}}
	applies={{{ [function[kms-field-applies],<field>] }}}
>
<tr>
<td><$text text={{{ [function[kms-field-label],<field>] }}}/></td>
<td><code><$text text=<<field>>/></code></td>
<td><$text text={{{ [[Reference/Kind/]addsuffix<kind>] :map[function[kms-ontology-lingo-text],<currentTiddler>] }}}/></td>
<td>
<%if [<blank>!match[]] %>
<$transclude $variable="kms-vocab-item" field=<<field>> value=<<blank>>/>
<$text text=" "/>
<<kms-ontology-lingo Reference/Default/Empty>>
<%else%>
—
<%endif%>
</td>
<td>
<%if [<applies>!match[]] %>
<$text text=<<applies>>/>
<%else%>
<<kms-ontology-lingo Reference/Applies/All>>
<%endif%>
</td>
<td><$text text={{{ [function[kms-field-description],<field>] }}}/></td>
</tr>
</$let>
</$list>
</tbody>
</table>
