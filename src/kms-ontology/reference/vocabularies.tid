title: $:/plugins/nikorion/kms-ontology/reference/vocabularies
type: text/vnd.tiddlywiki

\whitespace trim

<!-- One table per vocabulary field, in canonical order: what is read, what is stored, what it means. -->

<$list filter="[function[kms-fields]] :filter[function[kms-field-kind],<currentTiddler>prefix[vocab]]" variable="field">
<$let blank={{{ [function[kms-vocab-blank],<field>] }}}>
<h3><$text text={{{ [function[kms-field-label],<field>] }}}/><$text text=" "/><code><$text text=<<field>>/></code></h3>
<table class="kms-reference">
<thead>
<tr>
<th><<kms-ontology-lingo Reference/Column/Value>></th>
<th><<kms-ontology-lingo Reference/Column/Stored>></th>
<th><<kms-ontology-lingo Reference/Column/Meaning>></th>
</tr>
</thead>
<tbody>
<$list filter="[function[kms-vocab-values],<field>]" variable="slug">
<tr>
<td><$transclude $variable="kms-vocab-item" field=<<field>> value=<<slug>>/></td>
<td><%if [<slug>match<blank>] %><<kms-ontology-lingo Reference/Stored/Empty>><%else%><code><$text text=<<slug>>/></code><%endif%></td>
<td><$text text={{{ [function[kms-vocab-hint],<field>,<slug>] }}}/></td>
</tr>
</$list>
</tbody>
</table>
</$let>
</$list>
